# Copy to .env and adjust. Every setting is optional; the defaults run a self-contained demo.

# --- Data sources --------------------------------------------------------------------------
# demo | autoscout24 | marktplaats (comma-separated). Real sources are UNVERIFIED scrapers:
# run `make verify-sources` first and read the README section on terms of use.
SOURCES=demo
DEMO_MODE=true
CRAWL_INTERVAL_MIN=30
CRAWL_REQUEST_DELAY_S=4
CRAWL_MAX_PAGES=3

# --- Location --------------------------------------------------------------------------------
HOME_POSTCODE=3511
# Public URL of this app (used in push-notification links), e.g. your Tailscale name
APP_URL=http://localhost:8000

# --- Push notifications (https://ntfy.sh) ------------------------------------------------------
# Treat the topic like a password, or self-host ntfy and set a token.
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=
NTFY_TOKEN=
DIGEST_HOUR=8

# --- Claude API (optional) ---------------------------------------------------------------------
# Enables AI research of known issues for models outside the curated base, natural-language
# search via Claude (a rule-based parser works without it) and the per-advert AI check.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
ISSUE_RESEARCH_TTL_DAYS=180

# --- RDW / PDOK --------------------------------------------------------------------------------
ONLINE_ENRICHMENT=true
# Optional Socrata app token for higher RDW rate limits (https://opendata.rdw.nl)
RDW_APP_TOKEN=

# --- Access ------------------------------------------------------------------------------------
# Set both to require HTTP basic auth (recommended if reachable from the internet)
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
